go_scip_import_passed=0
go_scip_import_failed=0
go_scip_producer_failed=0
go_scip_invalid_input=0
go_scip_source_mismatch=0
go_scip_unsupported_source_encoding=0
go_scip_deadline_exceeded=0
go_scip_resource_limit=0
go_scip_inconsistent_summary=0
