extract_first_relevant_paths_query() {
    perl -MJSON::PP -e '
        use strict;
        use warnings;

        local $/;
        my $result = eval { decode_json(<STDIN>) };
        exit 1 if $@ || ref($result) ne q{HASH};
        my $match = $result->{matches}[0];
        exit 1 if ref($match) ne q{HASH};
        my $name = $match->{name};
        exit 1 if !defined($name) || ref($name) || $name eq q{}
          || length($name) > 256 || $name =~ /[[:cntrl:]]/;
        my @terms = split /\s+/, $name;
        exit 1 if @terms == 0 || @terms > 8
          || grep { length($_) > 64 } @terms;
        print $name;
    '
}

extract_first_symbol_selector() {
    perl -MJSON::PP -e '
        use strict;
        use warnings;

        local $/;
        my $result = eval { decode_json(<STDIN>) };
        exit 1 if $@ || ref($result) ne q{HASH};
        my $match = $result->{matches}[0];
        exit 1 if ref($match) ne q{HASH};
        my @values = (
            $result->{workspace_view},
            $result->{snapshot_sha256},
            $result->{generation},
            $match->{path},
            $match->{content_sha256},
            $match->{artifact_sha256},
            $match->{fact_ordinal},
            $match->{name_span}{start},
            $match->{name_span}{end},
        );
        exit 1 if !defined($values[0]) || ref($values[0])
          || $values[0] !~ /\A[1-9][0-9]*\z/;
        exit 1 if !defined($values[1]) || ref($values[1])
          || $values[1] !~ /\A[0-9a-f]{64}\z/;
        exit 1 if !defined($values[2]) || ref($values[2])
          || $values[2] !~ /\A[1-9][0-9]*\z/;
        exit 1 if !defined($values[3]) || ref($values[3])
          || $values[3] !~ /\Arwp1:h:[0-9A-F]+\z/;
        for my $index (4, 5) {
            exit 1 if !defined($values[$index]) || ref($values[$index])
              || $values[$index] !~ /\A[0-9a-f]{64}\z/;
        }
        for my $index (6, 7, 8) {
            exit 1 if !defined($values[$index]) || ref($values[$index])
              || $values[$index] !~ /\A[0-9]+\z/;
        }
        exit 1 if $values[7] >= $values[8];
        print join("\n", @values), "\n";
    '
}

validate_scip_symbol_resolve_not_produced() {
    perl -MJSON::PP -e '
        use strict;
        use warnings;

        local $/;
        my $result = eval { decode_json(<STDIN>) };
        exit 1 if $@ || ref($result) ne q{HASH};
        exit 1 if ($result->{schema_version} // q{}) != 1;
        exit 1 if ($result->{connected_workspace} // q{}) !~ /\Acwi1:h:[0-9A-F]+\z/
          || ($result->{source_slot} // q{}) !~ /\Assi1:h:[0-9A-F]+\z/;
        exit 1 if !defined($result->{workspace_view}) || ref($result->{workspace_view})
          || $result->{workspace_view} !~ /\A[1-9][0-9]*\z/;
        exit 1 if ($result->{resolution} // q{}) ne q{not_produced};
        exit 1 if defined($result->{symbol});
    '
}

validate_scip_evidence_not_produced() {
    perl -MJSON::PP -e '
        use strict;
        use warnings;

        local $/;
        my $result = eval { decode_json(<STDIN>) };
        exit 1 if $@ || ref($result) ne q{HASH};
        exit 1 if ($result->{schema_version} // q{}) != 1;
        exit 1 if ($result->{connected_workspace} // q{}) !~ /\Acwi1:h:[0-9A-F]+\z/
          || ($result->{source_slot} // q{}) !~ /\Assi1:h:[0-9A-F]+\z/;
        exit 1 if !defined($result->{workspace_view}) || ref($result->{workspace_view})
          || $result->{workspace_view} !~ /\A[1-9][0-9]*\z/;
        exit 1 if ($result->{resolution} // q{}) ne q{not_produced};
        for my $field (qw(overlay package_scope_sha256)) {
            exit 1 if !exists($result->{$field}) || defined($result->{$field});
        }
        for my $field (qw(occurrences_truncated relationships_truncated)) {
            exit 1 if !JSON::PP::is_bool($result->{$field}) || $result->{$field};
        }
        exit 1 if !defined($result->{output_bytes}) || ref($result->{output_bytes})
          || $result->{output_bytes} !~ /\A0\z/;
        for my $field (qw(occurrences relationships)) {
            exit 1 if ref($result->{$field}) ne q{ARRAY} || @{$result->{$field}} != 0;
        }
    '
}

validate_scip_relationship_trace_not_produced() {
    perl -MJSON::PP -e '
        use strict;
        use warnings;

        local $/;
        my $result = eval { decode_json(<STDIN>) };
        exit 1 if $@ || ref($result) ne q{HASH};
        exit 1 if ($result->{schema_version} // q{}) != 1;
        exit 1 if ($result->{connected_workspace} // q{}) !~ /\Acwi1:h:[0-9A-F]+\z/
          || ($result->{source_slot} // q{}) !~ /\Assi1:h:[0-9A-F]+\z/;
        exit 1 if !defined($result->{workspace_view}) || ref($result->{workspace_view})
          || $result->{workspace_view} !~ /\A[1-9][0-9]*\z/;
        exit 1 if ($result->{resolution} // q{}) ne q{not_produced};
        for my $field (qw(overlay package_scope_sha256)) {
            exit 1 if !exists($result->{$field}) || defined($result->{$field});
        }
        exit 1 if ($result->{direction} // q{}) ne q{outgoing};
        for my $field (qw(max_depth max_edges)) {
            exit 1 if !defined($result->{$field}) || ref($result->{$field})
              || $result->{$field} !~ /\A1\z/;
        }
        for my $field (qw(visited_symbols unexpanded_frontier_symbols output_bytes)) {
            exit 1 if !defined($result->{$field}) || ref($result->{$field})
              || $result->{$field} !~ /\A0\z/;
        }
        for my $field (qw(depth_limit_reached edge_limit_reached symbol_limit_reached output_limit_reached truncated)) {
            exit 1 if !JSON::PP::is_bool($result->{$field}) || $result->{$field};
        }
        exit 1 if ref($result->{edges}) ne q{ARRAY} || @{$result->{edges}} != 0;
        exit 1 if defined($result->{symbol});
    '
}

validate_outbound_sites() {
    perl -MJSON::PP -e '
        use strict;
        use warnings;

        local $/;
        my $result = eval { decode_json(<STDIN>) };
        exit 1 if $@ || ref($result) ne q{HASH};
        exit 1 if ($result->{schema_version} // q{}) != 1
          || ($result->{outbound_sites_profile} // q{}) != 1;
        exit 1 if ($result->{snapshot_sha256} // q{}) !~ /\A[0-9a-f]{64}\z/
          || !defined($result->{generation}) || ref($result->{generation})
          || $result->{generation} !~ /\A[1-9][0-9]*\z/;
        exit 1 if ($result->{availability} // q{}) ne q{complete}
          || ($result->{limitation} // q{})
          ne q{raw_syntax_observations_only_no_target_resolution_or_inferred_edges};
        exit 1 if ref($result->{selector}) ne q{HASH}
          || ref($result->{declaration}) ne q{HASH}
          || ref($result->{coverage}) ne q{HASH}
          || ref($result->{sites}) ne q{ARRAY};
        for my $field (qw(path content_sha256 artifact_sha256 fact_ordinal)) {
            exit 1 if !defined($result->{selector}{$field}) || ref($result->{selector}{$field});
        }
        exit 1 if $result->{selector}{path} !~ /\Arwp1:h:[0-9A-F]+\z/
          || $result->{selector}{content_sha256} !~ /\A[0-9a-f]{64}\z/
          || $result->{selector}{artifact_sha256} !~ /\A[0-9a-f]{64}\z/
          || $result->{selector}{fact_ordinal} !~ /\A[0-9]+\z/;
        exit 1 if ($result->{declaration}{language} // q{})
          !~ /\A(?:rust|go|typescript|tsx|python)\z/
          || ref($result->{declaration}{declaration_span}) ne q{HASH};
        for my $field (qw(searched skipped unresolved truncated)) {
            exit 1 if !defined($result->{coverage}{$field}) || ref($result->{coverage}{$field})
              || $result->{coverage}{$field} !~ /\A[0-9]+\z/;
        }
        for my $field (qw(sites_returned sites_total output_bytes)) {
            exit 1 if !defined($result->{$field}) || ref($result->{$field})
              || $result->{$field} !~ /\A[0-9]+\z/;
        }
        exit 1 if !JSON::PP::is_bool($result->{truncated});
        exit 1 if $result->{sites_returned} != @{$result->{sites}}
          || $result->{sites_returned} > $result->{sites_total}
          || ($result->{truncated} ? 1 : 0)
            != ($result->{sites_returned} < $result->{sites_total} ? 1 : 0);
        for my $site (@{$result->{sites}}) {
            exit 1 if ref($site) ne q{HASH};
            exit 1 if ($site->{path} // q{}) !~ /\Arwp1:h:[0-9A-F]+\z/
              || ($site->{content_sha256} // q{}) !~ /\A[0-9a-f]{64}\z/
              || ($site->{artifact_sha256} // q{}) !~ /\A[0-9a-f]{64}\z/
              || ($site->{language} // q{}) !~ /\A(?:rust|go|typescript|tsx|python)\z/
              || ($site->{ordinal} // q{}) !~ /\A[0-9]+\z/
              || ($site->{kind} // q{}) !~ /\A(?:import|reference|call|test_marker)\z/
              || ($site->{evidence} // q{}) !~ /\A(?:direct_syntax|syntax_heuristic)\z/
              || ($site->{target_resolution} // q{})
                ne q{not_attempted_no_resolution_profile};
            exit 1 if ref($site->{occurrence_span}) ne q{HASH}
              || ref($site->{target_span}) ne q{HASH};
        }
    '
}

validate_syntax_site_search() {
    perl -MJSON::PP -e '
        use strict;
        use warnings;

        local $/;
        my $result = eval { decode_json(<STDIN>) };
        exit 1 if $@ || ref($result) ne q{HASH};
        exit 1 if ($result->{schema_version} // q{}) != 1
          || ($result->{syntax_site_search_profile} // q{}) != 1;
        exit 1 if ($result->{target_sha256} // q{}) !~ /\A[0-9a-f]{64}\z/
          || ($result->{snapshot_sha256} // q{}) !~ /\A[0-9a-f]{64}\z/
          || !defined($result->{generation}) || ref($result->{generation})
          || $result->{generation} !~ /\A[1-9][0-9]*\z/;
        exit 1 if ($result->{availability} // q{}) !~ /\A(?:complete|not_produced)\z/
          || ($result->{limitation} // q{})
          ne q{exact_raw_target_syntax_observations_only_no_target_resolution_or_inferred_edges};
        exit 1 if ref($result->{coverage}) ne q{HASH} || ref($result->{sites}) ne q{ARRAY};
        for my $field (qw(searched skipped unresolved truncated)) {
            exit 1 if !defined($result->{coverage}{$field})
              || ref($result->{coverage}{$field})
              || $result->{coverage}{$field} !~ /\A[0-9]+\z/;
        }
        for my $field (qw(sites_returned sites_total output_bytes)) {
            exit 1 if !defined($result->{$field}) || ref($result->{$field})
              || $result->{$field} !~ /\A[0-9]+\z/;
        }
        exit 1 if !JSON::PP::is_bool($result->{truncated})
          || $result->{sites_returned} != @{$result->{sites}}
          || $result->{sites_returned} > $result->{sites_total}
          || ($result->{truncated} ? 1 : 0)
            != ($result->{sites_returned} < $result->{sites_total} ? 1 : 0);
        exit 1 if $result->{availability} eq q{not_produced}
          && ($result->{sites_returned} != 0 || $result->{sites_total} != 0
            || $result->{output_bytes} != 0);
        for my $site (@{$result->{sites}}) {
            exit 1 if ref($site) ne q{HASH};
            exit 1 if ($site->{path} // q{}) !~ /\Arwp1:h:[0-9A-F]+\z/
              || ($site->{content_sha256} // q{}) !~ /\A[0-9a-f]{64}\z/
              || ($site->{artifact_sha256} // q{}) !~ /\A[0-9a-f]{64}\z/
              || ($site->{language} // q{}) !~ /\A(?:rust|go|typescript|tsx|python)\z/
              || ($site->{ordinal} // q{}) !~ /\A[0-9]+\z/
              || ($site->{kind} // q{}) !~ /\A(?:import|reference|call|test_marker)\z/
              || ($site->{evidence} // q{}) !~ /\A(?:direct_syntax|syntax_heuristic)\z/
              || ($site->{target_resolution} // q{})
                ne q{not_attempted_no_resolution_profile};
            for my $span_field (qw(occurrence_span target_span)) {
                my $span = $site->{$span_field};
                exit 1 if ref($span) ne q{HASH}
                  || !defined($span->{start}) || ref($span->{start})
                  || $span->{start} !~ /\A[0-9]+\z/
                  || !defined($span->{end}) || ref($span->{end})
                  || $span->{end} !~ /\A[1-9][0-9]*\z/
                  || $span->{start} >= $span->{end};
            }
            exit 1 if !defined($site->{raw_target}) || ref($site->{raw_target});
        }
    '
}

syntax_site_search_has_no_matches() {
    perl -MJSON::PP -e '
        use strict;
        use warnings;

        local $/;
        my $result = eval { decode_json(<STDIN>) };
        exit 1 if $@ || ref($result) ne q{HASH};
        exit(($result->{sites_returned} // -1) == 0
          && ($result->{sites_total} // -1) == 0 ? 0 : 1);
    '
}

extract_first_syntax_site_search_target() {
    perl -MJSON::PP -e '
        use strict;
        use warnings;

        local $/;
        my $result = eval { decode_json(<STDIN>) };
        exit 1 if $@ || ref($result) ne q{HASH} || ref($result->{sites}) ne q{ARRAY};
        for my $site (@{$result->{sites}}) {
            next if ref($site) ne q{HASH};
            my $target = $site->{raw_target};
            next if !defined($target) || ref($target) || $target eq q{}
              || length($target) > 16 * 1024 || $target =~ /[\x00-\x1F\x7F]/;
            print $target;
            exit 0;
        }
        exit 1;
    '
}

syntax_site_search_has_exact_target() {
    perl -MJSON::PP -e '
        use strict;
        use warnings;

        my $target = shift @ARGV;
        exit 64 if !defined($target);
        local $/;
        my $result = eval { decode_json(<STDIN>) };
        exit 1 if $@ || ref($result) ne q{HASH} || ref($result->{sites}) ne q{ARRAY};
        exit 1 if ($result->{sites_returned} // 0) < 1
          || ($result->{sites_total} // 0) < 1;
        for my $site (@{$result->{sites}}) {
            exit 0 if ref($site) eq q{HASH}
              && defined($site->{raw_target}) && !ref($site->{raw_target})
              && $site->{raw_target} eq $target;
        }
        exit 1;
    ' "$1"
}

validate_test_markers() {
    perl -MJSON::PP -e '
        use strict;
        use warnings;

        local $/;
        my $result = eval { decode_json(<STDIN>) };
        exit 1 if $@ || ref($result) ne q{HASH};
        exit 1 if ($result->{schema_version} // q{}) != 1
          || ($result->{test_markers_profile} // q{}) != 1;
        exit 1 if ($result->{snapshot_sha256} // q{}) !~ /\A[0-9a-f]{64}\z/
          || !defined($result->{generation}) || ref($result->{generation})
          || $result->{generation} !~ /\A[1-9][0-9]*\z/;
        exit 1 if ($result->{availability} // q{}) ne q{complete}
          || ($result->{limitation} // q{})
          ne q{raw_syntax_observations_only_not_test_execution_or_relationship_resolution};
        exit 1 if ref($result->{coverage}) ne q{HASH}
          || ref($result->{language_coverage}) ne q{ARRAY}
          || ref($result->{markers}) ne q{ARRAY};
        for my $field (qw(searched skipped unresolved truncated)) {
            exit 1 if !defined($result->{coverage}{$field}) || ref($result->{coverage}{$field})
              || $result->{coverage}{$field} !~ /\A[0-9]+\z/;
        }
        for my $field (qw(markers_returned markers_total output_bytes)) {
            exit 1 if !defined($result->{$field}) || ref($result->{$field})
              || $result->{$field} !~ /\A[0-9]+\z/;
        }
        exit 1 if !JSON::PP::is_bool($result->{truncated});
        exit 1 if $result->{markers_returned} != @{$result->{markers}}
          || $result->{markers_returned} > $result->{markers_total}
          || ($result->{truncated} ? 1 : 0)
            != ($result->{markers_returned} < $result->{markers_total} ? 1 : 0);
        my $emitted = 0;
        for my $coverage (@{$result->{language_coverage}}) {
            exit 1 if ref($coverage) ne q{HASH}
              || ($coverage->{language} // q{}) !~ /\A(?:rust|go|typescript|tsx|python)\z/;
            for my $field (qw(indexed_files supported_files unsupported_files emitted_markers)) {
                exit 1 if !defined($coverage->{$field}) || ref($coverage->{$field})
                  || $coverage->{$field} !~ /\A[0-9]+\z/;
            }
            exit 1 if $coverage->{indexed_files}
              != $coverage->{supported_files} + $coverage->{unsupported_files};
            $emitted += $coverage->{emitted_markers};
        }
        exit 1 if $emitted != $result->{markers_total};
        for my $marker (@{$result->{markers}}) {
            exit 1 if ref($marker) ne q{HASH};
            exit 1 if ($marker->{path} // q{}) !~ /\Arwp1:h:[0-9A-F]+\z/
              || ($marker->{content_sha256} // q{}) !~ /\A[0-9a-f]{64}\z/
              || ($marker->{artifact_sha256} // q{}) !~ /\A[0-9a-f]{64}\z/
              || ($marker->{language} // q{}) !~ /\A(?:rust|go|typescript|tsx|python)\z/
              || ($marker->{ordinal} // q{}) !~ /\A[0-9]+\z/
              || ($marker->{kind} // q{}) ne q{test_marker}
              || ($marker->{evidence} // q{}) !~ /\A(?:direct_syntax|syntax_heuristic)\z/
              || ($marker->{target_resolution} // q{})
                ne q{not_attempted_no_resolution_profile};
            exit 1 if ref($marker->{occurrence_span}) ne q{HASH}
              || ref($marker->{target_span}) ne q{HASH};
        }
    '
}

validate_change_review() {
    perl -e '
        use strict;
        use warnings;

        my $expected_base = shift @ARGV;
        exit 64 if !defined($expected_base)
          || $expected_base !~ /\A(?:[0-9a-f]{40}|[0-9a-f]{64})\z/;
        my %fields;
        while (my $line = <STDIN>) {
            chomp $line;
            exit 1 if $line !~ /\A([a-z0-9_]+(?:\[[0-9]+\]\.(?:kind|path))?)=(.*)\z/;
            exit 1 if exists $fields{$1};
            $fields{$1} = $2;
        }
        for my $field (qw(operation change_manifest_profile base worktree_git_state_sha256 worktree_change_count indexed_context_availability indexed_context_reason indexed_snapshot_sha256 indexed_generation indexed_context_items indexed_context_omissions index_worktree_alignment verdict)) {
            exit 1 if !exists $fields{$field};
        }
        exit 1 if ($fields{operation} // q{}) ne q{verify}
          || ($fields{change_manifest_profile} // q{}) ne q{1}
          || ($fields{base} // q{}) ne $expected_base
          || ($fields{worktree_git_state_sha256} // q{}) !~ /\A[0-9a-f]{64}\z/
          || ($fields{worktree_change_count} // q{}) !~ /\A[0-9]+\z/
          || ($fields{index_worktree_alignment} // q{}) ne q{unverified}
          || ($fields{verdict} // q{}) ne q{not_provided};
        if (($fields{indexed_context_availability} // q{}) eq q{available}) {
            exit 1 if ($fields{indexed_context_reason} // q{}) ne q{not_applicable}
              || ($fields{indexed_snapshot_sha256} // q{}) !~ /\A[0-9a-f]{64}\z/
              || ($fields{indexed_generation} // q{}) !~ /\A[1-9][0-9]*\z/
              || ($fields{indexed_context_items} // q{}) !~ /\A[0-9]+\z/
              || ($fields{indexed_context_omissions} // q{}) !~ /\A[0-9]+\z/;
        } elsif (($fields{indexed_context_availability} // q{}) eq q{unavailable}) {
            exit 1 if ($fields{indexed_context_reason} // q{}) ne q{stale_source}
              || ($fields{indexed_snapshot_sha256} // q{}) ne q{not_provided}
              || ($fields{indexed_generation} // q{}) ne q{not_provided}
              || ($fields{indexed_context_items} // q{}) ne q{not_provided}
              || ($fields{indexed_context_omissions} // q{}) ne q{not_provided};
        } else {
            exit 1;
        }
        my @changes;
        for my $field (keys %fields) {
            next if $field !~ /\Achange\[([0-9]+)\]\.(kind|path)\z/;
            $changes[$1]{$2} = $fields{$field};
        }
        exit 1 if @changes != $fields{worktree_change_count};
        for my $change (@changes) {
            exit 1 if ref($change) ne q{HASH}
              || !defined($change->{kind}) || !defined($change->{path})
              || $change->{kind} !~ /\A(?:added|modified|deleted|type_changed|untracked)\z/
              || $change->{path} !~ /\Arwp1:h:[0-9A-F]+\z/;
        }
    ' "$1"
}

validate_mcp_change_review() {
    perl -MJSON::PP -e '
        use strict;
        use warnings;

        my $expected_base = shift @ARGV;
        exit 64 if !defined($expected_base)
          || $expected_base !~ /\A(?:[0-9a-f]{40}|[0-9a-f]{64})\z/;
        local $/;
        my $receipt = eval { decode_json(<STDIN>) };
        exit 1 if $@ || ref($receipt) ne q{HASH};
        for my $field (qw(schema_version change_manifest_profile base worktree_git_state_sha256 changes indexed_context_availability index_worktree_alignment verdict)) {
            exit 1 if !exists $receipt->{$field};
        }
        exit 1 if ($receipt->{schema_version} // q{}) != 1
          || ($receipt->{change_manifest_profile} // q{}) != 1
          || ($receipt->{base} // q{}) ne $expected_base
          || ($receipt->{worktree_git_state_sha256} // q{}) !~ /\A[0-9a-f]{64}\z/
          || ref($receipt->{changes}) ne q{ARRAY}
          || ($receipt->{index_worktree_alignment} // q{}) ne q{unverified}
          || ($receipt->{verdict} // q{}) ne q{not_provided};
        if (($receipt->{indexed_context_availability} // q{}) eq q{available}) {
            exit 1 if exists($receipt->{indexed_context_reason})
              || ($receipt->{indexed_snapshot_sha256} // q{}) !~ /\A[0-9a-f]{64}\z/
              || ($receipt->{indexed_generation} // q{}) !~ /\A[1-9][0-9]*\z/
              || ($receipt->{indexed_context_items} // q{}) !~ /\A[0-9]+\z/
              || ($receipt->{indexed_context_omissions} // q{}) !~ /\A[0-9]+\z/;
        } elsif (($receipt->{indexed_context_availability} // q{}) eq q{unavailable}) {
            exit 1 if ($receipt->{indexed_context_reason} // q{}) ne q{stale_source}
              || exists($receipt->{indexed_snapshot_sha256})
              || exists($receipt->{indexed_generation})
              || exists($receipt->{indexed_context_items})
              || exists($receipt->{indexed_context_omissions});
        } else {
            exit 1;
        }
        for my $change (@{$receipt->{changes}}) {
            exit 1 if ref($change) ne q{HASH}
              || ($change->{kind} // q{}) !~ /\A(?:added|modified|deleted|type_changed|untracked)\z/
              || ($change->{path} // q{}) !~ /\Arwp1:h:[0-9A-F]+\z/;
        }
    ' "$1"
}

RUN_DIRECTORY=$(mktemp -d "${TMPDIR:-/tmp}/repowitness-sibling-repositories.XXXXXX")
cleanup() {
    test -n "${RUN_DIRECTORY:-}" || return 0
    case "$RUN_DIRECTORY" in
        "${TMPDIR:-/tmp}"/repowitness-sibling-repositories.*)
            rm -rf -- "$RUN_DIRECTORY"
            ;;
        *)
            printf '%s\n' 'error: refusing to clean an unexpected temporary directory' >&2
            ;;
    esac
}
handle_signal() {
    cleanup
    trap - EXIT
    exit "$1"
}
trap cleanup EXIT
trap 'handle_signal 129' HUP
trap 'handle_signal 130' INT
trap 'handle_signal 143' TERM

if [ "$SKIP_BUILD" = false ]; then
    if ! (cd "$PROJECT_ROOT" && cargo build -p repowitness-cli --locked) \
        >"$RUN_DIRECTORY/build.stdout" 2>"$RUN_DIRECTORY/build.stderr"; then
        printf '%s\n' 'error: CLI build failed; no external repositories were tested' >&2
        exit 1
    fi
fi
if [ ! -x "$CLI" ]; then
    printf '%s\n' 'error: RepoWitness CLI binary is unavailable; run without --skip-build' >&2
    exit 69
fi

repositories=0
index_passed=0
index_failed=0
map_passed=0
map_failed=0
topology_passed=0
topology_failed=0
overview_passed=0
overview_failed=0
test_markers_passed=0
test_markers_failed=0
syntax_site_search_passed=0
syntax_site_search_failed=0
syntax_site_search_positive_passed=0
syntax_site_search_positive_unavailable=0
code_graph_syntax_site_search_passed=0
code_graph_syntax_site_search_failed=0
code_graph_syntax_site_search_positive_passed=0
code_graph_syntax_site_search_positive_unavailable=0
relevant_paths_passed=0
relevant_paths_failed=0
relevant_paths_positive_passed=0
relevant_paths_positive_unavailable=0
code_graph_relevant_paths_passed=0
code_graph_relevant_paths_failed=0
code_graph_relevant_paths_positive_passed=0
code_graph_relevant_paths_positive_unavailable=0
context_build_passed=0
context_build_failed=0
change_review_passed=0
change_review_failed=0
change_review_unavailable=0
change_review_command_failed=0
change_review_validation_failed=0
mcp_change_review_passed=0
mcp_change_review_failed=0
symbol_passed=0
symbol_failed=0
symbol_positive_passed=0
symbol_positive_unavailable=0
outbound_passed=0
outbound_failed=0
outbound_unavailable=0
scip_symbol_resolve_not_produced_passed=0
scip_symbol_resolve_not_produced_failed=0
scip_symbol_resolve_not_attempted_no_declaration=0
scip_symbol_resolve_not_attempted_no_candidate=0
scip_evidence_not_produced_passed=0
scip_evidence_not_produced_failed=0
scip_relationship_trace_not_produced_passed=0
