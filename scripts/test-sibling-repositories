validate_context_build() {
    perl -MJSON::PP -e '
        use strict;
        use warnings;

        local $/;
        my $result = eval { decode_json(<STDIN>) };
        exit 1 if $@ || ref($result) ne q{HASH};
        exit 1 if ($result->{schema_version} // q{}) != 2
          || ($result->{context_profile} // q{}) != 1
          || ($result->{reciprocal_rank_k} // q{}) != 60
          || ($result->{budget_estimator} // q{}) ne q{utf8_bytes_upper_bound_v1}
          || ($result->{budget_units} // q{}) != 4096;
        exit 1 if !defined($result->{used_units}) || ref($result->{used_units})
          || $result->{used_units} !~ /\A[0-9]+\z/
          || $result->{used_units} > $result->{budget_units};
        exit 1 if ($result->{query_sha256} // q{}) !~ /\A[0-9a-f]{64}\z/
          || ($result->{snapshot_sha256} // q{}) !~ /\A[0-9a-f]{64}\z/
          || !defined($result->{generation}) || ref($result->{generation})
          || $result->{generation} !~ /\A[1-9][0-9]*\z/;
        exit 1 if ref($result->{coverage}) ne q{HASH}
          || ref($result->{omissions}) ne q{ARRAY}
          || ref($result->{items}) ne q{ARRAY};
    '
}

mcp_code_graph_relevant_paths() {
    perl -MIPC::Open3 -MJSON::PP -e '
        use strict;
        use warnings;

        my ($cli, $identity, $database, $root, $query) = @ARGV;
        exit 64 if !defined($query);
        open my $stderr, q{>}, q{/dev/null} or exit 1;
        my $pid = open3(
            my $input,
            my $output,
            $stderr,
            $cli,
            q{mcp-serve},
            q{--repository-id},
            $identity,
            q{--database},
            $database,
            q{--root},
            $root,
        );
        select((select($input), $| = 1)[0]);
        my $initialize = {
            jsonrpc => q{2.0},
            id => 1,
            method => q{initialize},
            params => {
                protocolVersion => q{2025-11-25},
                capabilities => {},
                clientInfo => { name => q{repowitness-sibling-smoke}, version => q{1} },
            },
        };
        print {$input} encode_json($initialize), qq{\n} or exit 1;
        my $initialized;
        while (my $line = <$output>) {
            my $message = eval { decode_json($line) };
            exit 1 if $@ || ref($message) ne q{HASH};
            $initialized = $message if defined($message->{id}) && $message->{id} eq q{1};
            last if defined($initialized);
        }
        exit 1 if !defined($initialized) || ref($initialized->{result}) ne q{HASH};

        for my $message (
            {
                jsonrpc => q{2.0},
                method => q{notifications/initialized},
            },
            {
                jsonrpc => q{2.0},
                id => 2,
                method => q{tools/call},
                params => {
                    name => q{code_graph_query},
                    arguments => {
                        operation => q{relevant_paths},
                        query => $query,
                        max_paths => 1,
                    },
                },
            },
        ) {
            print {$input} encode_json($message), qq{\n} or exit 1;
        }
        close($input) or exit 1;

        my $response;
        while (my $line = <$output>) {
            my $message = eval { decode_json($line) };
            exit 1 if $@ || ref($message) ne q{HASH};
            $response = $message if defined($message->{id}) && $message->{id} eq q{2};
        }
        close($output);
        waitpid($pid, 0);
        close($stderr);
        exit 1 if $? != 0;
        exit 1 if !defined($response) || ref($response->{result}) ne q{HASH};
        my $result = $response->{result};
        exit 1 if ($result->{isError} // 1) || ref($result->{structuredContent}) ne q{HASH};
        print encode_json($result->{structuredContent});
    ' "$CLI" "$identity" "$database" "$candidate" "$1"
}

