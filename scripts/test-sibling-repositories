#!/bin/sh
# Run the production index, path-only topology, architecture-map, architecture-overview,
# typed-symbol-discovery, lexical path-navigation (direct and finite-MCP-envelope),
# context compilation through the agent-oriented MCP aliases,
# exact raw syntax-target search (direct and finite-MCP-envelope), no-overlay
# SCIP-evidence, SCIP-symbol-resolution, and SCIP-relationship-trace smoke,
# repository-scoped test-marker, revision-pinned change-receipt, and exact
# outbound-site loop. The opt-in
# --rust-scip and --go-scip modes additionally invoke the installed producer
# for every eligible sibling with indexed Rust or Go source, import the resulting
# private temporary artifact, and report only aggregate categorical outcomes.
# loop against every direct Git worktree beside this workspace. External
# repositories are confidential smoke inputs: this script deliberately emits aggregate
# outcomes only.
set -eu

PROJECT_ROOT=$(CDPATH= cd "$(dirname "$0")/.." && pwd)
SIBLING_ROOT=$(dirname "$PROJECT_ROOT")
case "${CARGO_TARGET_DIR:-}" in
    '')
        TARGET_DIRECTORY=$PROJECT_ROOT/target
        ;;
    /*)
        TARGET_DIRECTORY=$CARGO_TARGET_DIR
        ;;
    *)
        TARGET_DIRECTORY=$PROJECT_ROOT/$CARGO_TARGET_DIR
        ;;
esac
CLI=$TARGET_DIRECTORY/debug/repowitness

umask 077

usage() {
    printf '%s\n' 'usage: ./scripts/test-sibling-repositories [--skip-build] [--rust-scip] [--go-scip] [--include-project] [--repository <path>]' >&2
    exit 64
}

SKIP_BUILD=false
RUST_SCIP=false
GO_SCIP=false
INCLUDE_PROJECT=false
TEST_REPOSITORY=
SCIP_GO=${SCIP_GO:-scip-go}
while [ "$#" -gt 0 ]; do
    case "$1" in
        --skip-build)
            test "$SKIP_BUILD" = false || usage
            SKIP_BUILD=true
            ;;
        --rust-scip)
            test "$RUST_SCIP" = false || usage
            RUST_SCIP=true
            ;;
        --go-scip)
            test "$GO_SCIP" = false || usage
            GO_SCIP=true
            ;;
        --include-project)
            test "$INCLUDE_PROJECT" = false || usage
            INCLUDE_PROJECT=true
            ;;
        --repository)
            test "$TEST_REPOSITORY" = '' || usage
            test "$#" -ge 2 || usage
            TEST_REPOSITORY=$2
            shift
            ;;
        *)
            usage
            ;;
    esac
    shift
done

command -v git >/dev/null 2>&1 || {
    printf '%s\n' 'error: Git is required' >&2
    exit 69
}
command -v perl >/dev/null 2>&1 || {
    printf '%s\n' 'error: Perl with JSON::PP is required' >&2
    exit 69
}
command -v mktemp >/dev/null 2>&1 || {
    printf '%s\n' 'error: mktemp is required' >&2
    exit 69
}
if [ "$RUST_SCIP" = true ]; then
    command -v rust-analyzer >/dev/null 2>&1 || {
        printf '%s\n' 'error: rust-analyzer is required with --rust-scip' >&2
        exit 69
    }
fi
if [ "$GO_SCIP" = true ]; then
    command -v "$SCIP_GO" >/dev/null 2>&1 || {
        printf '%s\n' 'error: scip-go is required with --go-scip; set SCIP_GO when it is not on PATH' >&2
        exit 69
    }
fi

safe_git() (
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY
    unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_SHALLOW_FILE GIT_COMMON_DIR
    unset GIT_CONFIG GIT_CONFIG_COUNT GIT_CONFIG_PARAMETERS GIT_NAMESPACE
    unset GIT_IMPLICIT_WORK_TREE GIT_CEILING_DIRECTORIES
    unset GIT_DISCOVERY_ACROSS_FILESYSTEM GIT_REFERENCE_BACKEND
    unset GIT_LITERAL_PATHSPECS GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS
    unset GIT_ICASE_PATHSPECS GIT_EXTERNAL_DIFF GIT_EXEC_PATH GIT_TEMPLATE_DIR
    unset GIT_TRACE GIT_TRACE2 GIT_TRACE2_EVENT GIT_TRACE2_PERF
    export GIT_CONFIG_NOSYSTEM=1
    export GIT_CONFIG_GLOBAL=/dev/null
    export GIT_CONFIG_SYSTEM=/dev/null
    export GIT_TERMINAL_PROMPT=0
    export GCM_INTERACTIVE=never
    export GIT_OPTIONAL_LOCKS=0
    export GIT_NO_REPLACE_OBJECTS=1
    export GIT_PAGER=cat
    export PAGER=cat
    command git --no-pager --literal-pathspecs \
        -c core.fsmonitor=false \
        -c core.hooksPath=/dev/null \
        -c core.excludesFile=/dev/null \
        -c core.untrackedCache=false \
        -c diff.external= \
        -c protocol.file.allow=never \
        "$@"
)

is_git_worktree() {
    safe_git -C "$1" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

validate_architecture_map() {
    perl -MJSON::PP -e '
        use strict;
        use warnings;

        local $/;
        my $map = eval { decode_json(<STDIN>) };
        exit 1 if $@ || ref($map) ne q{HASH};
        exit 1 if ($map->{schema_version} // q{}) != 1;
        exit 1 if ($map->{map_profile} // q{}) != 1;
        exit 1 if ($map->{snapshot_sha256} // q{}) !~ /\A[0-9a-f]{64}\z/;
        exit 1 if !defined($map->{generation}) || ref($map->{generation})
          || $map->{generation} !~ /\A[1-9][0-9]*\z/;
        exit 1 if !JSON::PP::is_bool($map->{truncated});
        exit 1 if ($map->{limitation} // q{})
          ne q{file_inventory_only_no_relationship_inference};
        exit 1 if ref($map->{coverage}) ne q{HASH}
          || ref($map->{languages}) ne q{ARRAY}
          || ref($map->{files}) ne q{ARRAY};
        for my $field (qw(total_files total_declarations files_returned output_bytes)) {
            exit 1 if !defined($map->{$field}) || ref($map->{$field})
              || $map->{$field} !~ /\A[0-9]+\z/;
        }
        for my $field (qw(searched skipped unresolved truncated)) {
            exit 1 if !defined($map->{coverage}{$field}) || ref($map->{coverage}{$field})
              || $map->{coverage}{$field} !~ /\A[0-9]+\z/;
        }
        exit 1 if $map->{files_returned} != @{$map->{files}}
          || $map->{files_returned} > $map->{total_files};
        exit 1 if ($map->{truncated} ? 1 : 0)
          != ($map->{files_returned} < $map->{total_files} ? 1 : 0);
        for my $language (@{$map->{languages}}) {
            exit 1 if ref($language) ne q{HASH};
            for my $field (qw(language files declarations)) {
                exit 1 if !defined($language->{$field}) || ref($language->{$field});
            }
        }
        for my $file (@{$map->{files}}) {
            exit 1 if ref($file) ne q{HASH};
            for my $field (qw(path language content_sha256 artifact_sha256 producer_manifest_sha256 declaration_count)) {
                exit 1 if !defined($file->{$field}) || ref($file->{$field});
            }
            exit 1 if $file->{path} !~ /\Arwp1:h:[0-9A-F]+\z/
              || $file->{language} !~ /\A(?:rust|go|typescript|tsx|python)\z/
              || $file->{content_sha256} !~ /\A[0-9a-f]{64}\z/
              || $file->{artifact_sha256} !~ /\A[0-9a-f]{64}\z/
              || $file->{producer_manifest_sha256} !~ /\A[0-9a-f]{64}\z/
              || $file->{declaration_count} !~ /\A[0-9]+\z/;
        }
    '
}

validate_repository_topology() {
    perl -MJSON::PP -e '
        use strict;
        use warnings;

        local $/;
        my $topology = eval { decode_json(<STDIN>) };
        exit 1 if $@ || ref($topology) ne q{HASH};
        exit 1 if ($topology->{schema_version} // q{}) != 1;
        exit 1 if ($topology->{topology_profile} // q{}) != 1;
        exit 1 if ($topology->{snapshot_sha256} // q{}) !~ /\A[0-9a-f]{64}\z/;
        exit 1 if ($topology->{topology_sha256} // q{}) !~ /\A[0-9a-f]{64}\z/;
        exit 1 if !defined($topology->{generation}) || ref($topology->{generation})
          || $topology->{generation} !~ /\A[1-9][0-9]*\z/;
        exit 1 if ($topology->{limitation} // q{})
          ne q{inventory_only_no_semantic_relationship_inference};
        exit 1 if ref($topology->{coverage}) ne q{HASH}
          || ref($topology->{categories}) ne q{ARRAY}
          || ref($topology->{entries}) ne q{ARRAY};
        for my $field (qw(total_paths paths_returned output_bytes)) {
            exit 1 if !defined($topology->{$field}) || ref($topology->{$field})
              || $topology->{$field} !~ /\A[0-9]+\z/;
        }
        for my $field (qw(discovered_paths omitted_paths)) {
            exit 1 if !defined($topology->{coverage}{$field})
              || ref($topology->{coverage}{$field})
              || $topology->{coverage}{$field} !~ /\A[0-9]+\z/;
        }
        exit 1 if $topology->{coverage}{omitted_paths} != 0
          || $topology->{coverage}{discovered_paths} != $topology->{total_paths}
          || $topology->{paths_returned} != @{$topology->{entries}}
          || $topology->{paths_returned} > $topology->{total_paths};
        exit 1 if !JSON::PP::is_bool($topology->{truncated})
          || ($topology->{truncated} ? 1 : 0)
            != ($topology->{paths_returned} < $topology->{total_paths} ? 1 : 0);
        my @expected = qw(agent_instruction build_descriptor configuration_descriptor documentation other_tracked_file package_descriptor workflow_descriptor);
        exit 1 if @{$topology->{categories}} != @expected;
        for my $index (0 .. $#expected) {
            my $category = $topology->{categories}[$index];
            exit 1 if ref($category) ne q{HASH}
              || ($category->{category} // q{}) ne $expected[$index]
              || !defined($category->{paths}) || ref($category->{paths})
              || $category->{paths} !~ /\A[0-9]+\z/;
        }
        for my $entry (@{$topology->{entries}}) {
            exit 1 if ref($entry) ne q{HASH}
              || ($entry->{path} // q{}) !~ /\Arwp1:h:[0-9A-F]+\z/
              || ($entry->{category} // q{}) !~ /\A(?:documentation|agent_instruction|workflow_descriptor|build_descriptor|package_descriptor|configuration_descriptor|other_tracked_file)\z/;
        }
    '
}

validate_architecture_overview() {
    perl -MJSON::PP -e '
        use strict;
        use warnings;

        local $/;
        my $overview = eval { decode_json(<STDIN>) };
        exit 1 if $@ || ref($overview) ne q{HASH};
        exit 1 if ($overview->{schema_version} // q{}) != 1;
        exit 1 if ($overview->{overview_profile} // q{}) != 1;
        exit 1 if ($overview->{snapshot_sha256} // q{}) !~ /\A[0-9a-f]{64}\z/;
        exit 1 if !defined($overview->{generation}) || ref($overview->{generation})
          || $overview->{generation} !~ /\A[1-9][0-9]*\z/;
        exit 1 if ($overview->{source_producer_manifest_sha256} // q{})
          !~ /\A[0-9a-f]{64}\z/;
        exit 1 if ref($overview->{coverage}) ne q{HASH}
          || ref($overview->{limitations}) ne q{ARRAY}
          || ref($overview->{languages}) ne q{ARRAY}
          || ref($overview->{kinds}) ne q{ARRAY}
          || ref($overview->{source_roots}) ne q{ARRAY}
          || ref($overview->{entry_point_candidates}) ne q{ARRAY}
          || ref($overview->{files}) ne q{ARRAY};
        exit 1 if join(q{,}, @{$overview->{limitations}})
          ne q{source_fact_aggregate_only_no_relationship_inference,top_level_path_buckets_are_not_package_or_ownership_boundaries,function_named_main_candidates_are_not_runtime_entry_point_proof};
        for my $field (qw(searched skipped unresolved truncated)) {
            exit 1 if !defined($overview->{coverage}{$field})
              || ref($overview->{coverage}{$field})
              || $overview->{coverage}{$field} !~ /\A[0-9]+\z/;
        }
        for my $field (qw(total_files total_declarations total_source_roots source_roots_returned total_entry_point_candidates entry_point_candidates_returned files_returned output_bytes)) {
            exit 1 if !defined($overview->{$field}) || ref($overview->{$field})
              || $overview->{$field} !~ /\A[0-9]+\z/;
        }
        for my $field (qw(source_roots_truncated entry_point_candidates_truncated files_truncated)) {
            exit 1 if !JSON::PP::is_bool($overview->{$field});
        }
        exit 1 if $overview->{source_roots_returned} != @{$overview->{source_roots}}
          || $overview->{entry_point_candidates_returned} != @{$overview->{entry_point_candidates}}
          || $overview->{files_returned} != @{$overview->{files}};
        exit 1 if $overview->{source_roots_returned} > $overview->{total_source_roots}
          || $overview->{entry_point_candidates_returned} > $overview->{total_entry_point_candidates}
          || $overview->{files_returned} > $overview->{total_files}
          || $overview->{total_source_roots} > $overview->{total_files}
          || $overview->{total_entry_point_candidates} > $overview->{total_declarations};
        exit 1 if ($overview->{source_roots_truncated} ? 1 : 0)
          != ($overview->{source_roots_returned} < $overview->{total_source_roots} ? 1 : 0);
        exit 1 if ($overview->{entry_point_candidates_truncated} ? 1 : 0)
          != ($overview->{entry_point_candidates_returned} < $overview->{total_entry_point_candidates} ? 1 : 0);
        exit 1 if ($overview->{files_truncated} ? 1 : 0)
          != ($overview->{files_returned} < $overview->{total_files} ? 1 : 0);
        for my $root (@{$overview->{source_roots}}) {
            exit 1 if ref($root) ne q{HASH};
            exit 1 if ($root->{kind} // q{}) !~ /\A(?:repository_root|top_level_directory)\z/;
            exit 1 if ($root->{kind} eq q{repository_root}) && defined($root->{path});
            exit 1 if ($root->{kind} eq q{top_level_directory})
              && (!defined($root->{path}) || ref($root->{path})
                || $root->{path} !~ /\Arwp1:h:[0-9A-F]+\z/);
            for my $field (qw(files declarations)) {
                exit 1 if !defined($root->{$field}) || ref($root->{$field})
                  || $root->{$field} !~ /\A[0-9]+\z/;
            }
        }
        for my $candidate (@{$overview->{entry_point_candidates}}) {
            exit 1 if ref($candidate) ne q{HASH};
            for my $field (qw(path fact_ordinal content_sha256 artifact_sha256 producer_manifest_sha256 evidence_tier language kind name qualified_name name_span declaration_span)) {
                exit 1 if !defined($candidate->{$field});
            }
            exit 1 if ref($candidate->{path}) || $candidate->{path} !~ /\Arwp1:h:[0-9A-F]+\z/
              || ref($candidate->{fact_ordinal}) || $candidate->{fact_ordinal} !~ /\A[0-9]+\z/
              || ref($candidate->{content_sha256}) || $candidate->{content_sha256} !~ /\A[0-9a-f]{64}\z/
              || ref($candidate->{artifact_sha256}) || $candidate->{artifact_sha256} !~ /\A[0-9a-f]{64}\z/
              || ref($candidate->{producer_manifest_sha256}) || $candidate->{producer_manifest_sha256} !~ /\A[0-9a-f]{64}\z/
              || ref($candidate->{evidence_tier}) || $candidate->{evidence_tier} ne q{syntax}
              || ref($candidate->{language}) || $candidate->{language} !~ /\A(?:rust|go|typescript|tsx|python)\z/
              || ref($candidate->{kind}) || $candidate->{kind} ne q{function}
              || ref($candidate->{name}) || $candidate->{name} ne q{main}
              || ref($candidate->{qualified_name});
            for my $span_field (qw(name_span declaration_span)) {
                my $span = $candidate->{$span_field};
                exit 1 if ref($span) ne q{HASH};
                exit 1 if !defined($span->{start}) || ref($span->{start})
                  || $span->{start} !~ /\A[0-9]+\z/
                  || !defined($span->{end}) || ref($span->{end})
                  || $span->{end} !~ /\A[1-9][0-9]*\z/
                  || $span->{start} >= $span->{end};
            }
        }
        for my $file (@{$overview->{files}}) {
            exit 1 if ref($file) ne q{HASH};
            for my $field (qw(path language content_sha256 artifact_sha256 producer_manifest_sha256 declaration_count)) {
                exit 1 if !defined($file->{$field}) || ref($file->{$field});
            }
            exit 1 if $file->{path} !~ /\Arwp1:h:[0-9A-F]+\z/
              || $file->{language} !~ /\A(?:rust|go|typescript|tsx|python)\z/
              || $file->{content_sha256} !~ /\A[0-9a-f]{64}\z/
              || $file->{artifact_sha256} !~ /\A[0-9a-f]{64}\z/
              || $file->{producer_manifest_sha256} !~ /\A[0-9a-f]{64}\z/
              || $file->{declaration_count} !~ /\A[0-9]+\z/;
        }
    '
}

validate_symbol_search() {
    expected_match_mode=$1
    perl -MJSON::PP -e '
        use strict;
        use warnings;

        my $expected_match_mode = shift @ARGV;
        local $/;
        my $result = eval { decode_json(<STDIN>) };
        exit 1 if $@ || ref($result) ne q{HASH};
        exit 1 if ($result->{schema_version} // q{}) != 1;
        exit 1 if ($result->{query_profile} // q{}) != 1;
        exit 1 if ($result->{match_mode} // q{}) ne $expected_match_mode;
        exit 1 if !defined($result->{generation}) || ref($result->{generation})
          || $result->{generation} !~ /\A[1-9][0-9]*\z/;
        exit 1 if ref($result->{coverage}) ne q{HASH}
          || ref($result->{limitations}) ne q{ARRAY}
          || ref($result->{matches}) ne q{ARRAY};
        for my $field (qw(matches_returned matches_total)) {
            exit 1 if !defined($result->{$field}) || ref($result->{$field})
              || $result->{$field} !~ /\A[0-9]+\z/;
        }
        exit 1 if $result->{matches_returned} != @{$result->{matches}}
          || $result->{matches_returned} > $result->{matches_total};
        exit 1 if join(q{,}, @{$result->{limitations}})
          ne q{direct_syntax_declarations_only,no_name_based_relationship_resolution};
        for my $match (@{$result->{matches}}) {
            exit 1 if ref($match) ne q{HASH};
            for my $field (qw(path fact_ordinal content_sha256 artifact_sha256 producer_manifest_sha256 evidence_tier language kind name qualified_name name_span declaration_span)) {
                exit 1 if !defined($match->{$field});
            }
            exit 1 if ref($match->{name_span}) ne q{HASH}
              || ref($match->{declaration_span}) ne q{HASH};
        }
    ' "$expected_match_mode"
}

validate_relevant_paths() {
    perl -MJSON::PP -e '
        use strict;
        use warnings;

        local $/;
        my $result = eval { decode_json(<STDIN>) };
        exit 1 if $@ || ref($result) ne q{HASH};
        exit 1 if ($result->{schema_version} // q{}) != 1
          || ($result->{path_ranking_profile} // q{}) != 1;
        exit 1 if ($result->{snapshot_sha256} // q{}) !~ /\A[0-9a-f]{64}\z/
          || !defined($result->{generation}) || ref($result->{generation})
          || $result->{generation} !~ /\A[1-9][0-9]*\z/
          || ($result->{query_sha256} // q{}) !~ /\A[0-9a-f]{64}\z/
          || ($result->{resolution} // q{}) !~ /\A(?:confirmed|unresolved)\z/;
        exit 1 if ref($result->{coverage}) ne q{HASH}
          || ref($result->{limitations}) ne q{ARRAY}
          || ref($result->{paths}) ne q{ARRAY}
          || ref($result->{matches}) ne q{ARRAY};
        exit 1 if join(q{,}, @{$result->{limitations}})
          ne q{indexed_supported_language_declaration_lexical_only,ordered_by_returned_match_count_then_canonical_path,path_summaries_cover_only_returned_declaration_matches,no_relationship_or_semantic_relevance_claim};
        for my $field (qw(matches_returned matches_total paths_returned returned_match_paths_total)) {
            exit 1 if !defined($result->{$field}) || ref($result->{$field})
              || $result->{$field} !~ /\A[0-9]+\z/;
        }
        for my $field (qw(searched skipped unresolved truncated)) {
            exit 1 if !defined($result->{coverage}{$field})
              || ref($result->{coverage}{$field})
              || $result->{coverage}{$field} !~ /\A[0-9]+\z/;
        }
        exit 1 if !JSON::PP::is_bool($result->{returned_match_paths_truncated});
        exit 1 if $result->{matches_returned} != @{$result->{matches}}
          || $result->{matches_returned} > $result->{matches_total}
          || $result->{paths_returned} != @{$result->{paths}}
          || $result->{paths_returned} > $result->{returned_match_paths_total}
          || ($result->{returned_match_paths_truncated} ? 1 : 0)
            != ($result->{paths_returned} < $result->{returned_match_paths_total} ? 1 : 0);
        my $declarations = 0;
        my $previous;
        for my $path (@{$result->{paths}}) {
            exit 1 if ref($path) ne q{HASH}
              || ($path->{path} // q{}) !~ /\Arwp1:h:[0-9A-F]+\z/
              || ($path->{content_sha256} // q{}) !~ /\A[0-9a-f]{64}\z/
              || !defined($path->{matching_declarations}) || ref($path->{matching_declarations})
              || $path->{matching_declarations} !~ /\A[1-9][0-9]*\z/
              || !defined($path->{first_fact_ordinal}) || ref($path->{first_fact_ordinal})
              || $path->{first_fact_ordinal} !~ /\A[0-9]+\z/;
            $declarations += $path->{matching_declarations};
            if (defined($previous)) {
                exit 1 if $previous->{matching_declarations} < $path->{matching_declarations};
                exit 1 if $previous->{matching_declarations} == $path->{matching_declarations}
                  && $previous->{path} gt $path->{path};
            }
            $previous = $path;
        }
        exit 1 if $declarations > $result->{matches_returned};
        exit 1 if !$result->{returned_match_paths_truncated}
          && $declarations != $result->{matches_returned};
        exit 1 if ($result->{resolution} eq q{confirmed}) != ($result->{matches_returned} > 0);
        exit 1 if ($result->{resolution} eq q{unresolved})
          && ($result->{matches_returned} != 0 || $result->{paths_returned} != 0);
    '
}

map_has_declarations() {
    perl -MJSON::PP -e '
        use strict;
        use warnings;

        local $/;
        my $map = eval { decode_json(<STDIN>) };
        exit 1 if $@ || ref($map) ne q{HASH};
        exit(($map->{total_declarations} // 0) > 0 ? 0 : 1);
    '
}

map_has_rust_files() {
    perl -MJSON::PP -e '
        use strict;
        use warnings;

        local $/;
        my $map = eval { decode_json(<STDIN>) };
        exit 1 if $@ || ref($map) ne q{HASH} || ref($map->{languages}) ne q{ARRAY};
        for my $language (@{$map->{languages}}) {
            next if ref($language) ne q{HASH};
            exit 0 if ($language->{language} // q{}) eq q{rust}
              && defined($language->{files}) && !ref($language->{files})
              && $language->{files} =~ /\A[1-9][0-9]*\z/;
        }
        exit 1;
    '
}

map_has_go_files() {
    perl -MJSON::PP -e '
        use strict;
        use warnings;

        local $/;
        my $map = eval { decode_json(<STDIN>) };
        exit 1 if $@ || ref($map) ne q{HASH} || ref($map->{languages}) ne q{ARRAY};
        for my $language (@{$map->{languages}}) {
            next if ref($language) ne q{HASH};
            exit 0 if ($language->{language} // q{}) eq q{go}
              && defined($language->{files}) && !ref($language->{files})
              && $language->{files} =~ /\A[1-9][0-9]*\z/;
        }
        exit 1;
    '
}

scip_import_failure_category() {
    sed -n 's/^error: SCIP import failed (category=\([a-z_][a-z_]*\))$/\1/p' "$1"
}

scip_go_import_failure_category() {
    if grep -qx 'error: scip-go SCIP production failed' "$1"; then
        printf '%s\n' producer
        return
    fi
    scip_import_failure_category "$1"
}

symbol_search_has_match() {
    perl -MJSON::PP -e '
        use strict;
        use warnings;

        local $/;
        my $result = eval { decode_json(<STDIN>) };
        exit 1 if $@ || ref($result) ne q{HASH};
        exit(($result->{matches_returned} // 0) > 0 ? 0 : 1);
    '
}

symbol_search_has_no_matches() {
    perl -MJSON::PP -e '
        use strict;
        use warnings;

        local $/;
        my $result = eval { decode_json(<STDIN>) };
        exit 1 if $@ || ref($result) ne q{HASH};
        exit(($result->{matches_returned} // -1) == 0
          && ($result->{matches_total} // -1) == 0 ? 0 : 1);
    '
}

