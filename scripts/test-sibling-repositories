validate_code_graph_relevant_paths() {
    perl -MJSON::PP -e '
        use strict;
        use warnings;

        local $/;
        my $envelope = eval { decode_json(<STDIN>) };
        exit 1 if $@ || ref($envelope) ne q{HASH};
        exit 1 if ($envelope->{schema_version} // q{}) != 1
          || ($envelope->{code_graph_query_profile} // q{}) != 1
          || ($envelope->{operation} // q{}) ne q{relevant_paths};
        exit 1 if !defined($envelope->{output_bytes}) || ref($envelope->{output_bytes})
          || $envelope->{output_bytes} !~ /\A[0-9]+\z/;
        exit 1 if ref($envelope->{result}) ne q{HASH};
        print encode_json($envelope->{result});
    '
}

