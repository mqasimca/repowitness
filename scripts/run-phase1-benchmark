#!/bin/sh
set -eu
umask 077

MANIFEST=benchmarks/phase1/manifest.json
. ./scripts/phase1-benchmark-support
. ./scripts/phase1-benchmark-suites
unset PHASE1_CAPTURE_DEADLINE_MS

if [ "$#" -ne 1 ]; then
    echo "usage: ./scripts/run-phase1-benchmark <public-corpus>" >&2
    exit 64
fi

CORPUS_INPUT=$1

BENCHMARK_TEMP=$(mktemp -d "${TMPDIR:-/tmp}/repowitness-phase1.XXXXXXXX")
cleanup() {
    rm -rf "$BENCHMARK_TEMP"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

if ! CORPUS_ROOT=$(resolve_local_corpus_root "$CORPUS_INPUT"); then
    echo "error: benchmark corpus path is invalid" >&2
    exit 65
fi
unset CORPUS_INPUT

if ! run_bounded_capture \
    "$BENCHMARK_TEMP/manifest-check.output" "$BENCHMARK_TEMP/manifest-check.log" \
    ./scripts/check-benchmarks
then
    echo "error: benchmark manifest validation failed" >&2
    exit 65
fi
if ! run_bounded_capture \
    "$BENCHMARK_TEMP/manifest-values.output" "$BENCHMARK_TEMP/manifest-read.log" \
    perl -MJSON::PP -e '
    use strict;
    use warnings;

    my ($path) = @ARGV;
    my @expected = qw(
      atomic-two-source-publication
      same-repository-two-worktrees
      quiet-polling-no-publication
      moving-selector-final-fence
      package-scope-clean-incremental-equivalence
      native-graph-read-suite
      compatibility-schema-suite
      retention-plan-apply-restart
    );
    open my $handle, "<:raw", $path or die "cannot read benchmark manifest\n";
    local $/;
    my $manifest = decode_json(<$handle>);
    close $handle;
    my $corpora = $manifest->{corpora};
    die "benchmark corpus profile is invalid\n"
      if ref($corpora) ne "ARRAY" || @$corpora != 1;
    my $revision = $corpora->[0]->{revision};
    die "benchmark corpus revision is invalid\n"
      if !defined($revision) || ref($revision) || $revision !~ /\A[0-9a-f]{40}\z/;
    my $workloads = $manifest->{phase1_workloads};
    die "benchmark workload profile is invalid\n"
      if ref($workloads) ne "ARRAY" || @$workloads != @expected;
    my %by_id;
    for my $workload (@$workloads) {
        die "benchmark workload is invalid\n" if ref($workload) ne "HASH";
        my $id = $workload->{id};
        my $iterations = $workload->{iterations};
        die "benchmark workload is invalid\n"
          if !defined($id) || ref($id) || exists($by_id{$id})
          || !defined($iterations) || ref($iterations)
          || $iterations !~ /\A[1-9][0-9]*\z/ || $iterations > 1000;
        $by_id{$id} = $iterations;
    }
    die "benchmark workload profile differs from the runner\n"
      if join("\0", sort keys %by_id) ne join("\0", sort @expected);
    for my $id (
        qw(
        quiet-polling-no-publication
        native-graph-read-suite
        retention-plan-apply-restart
        )
      )
    {
        die "operation-probe workloads require at least two runs\n"
          if $by_id{$id} < 2;
    }
    my $correctness = $manifest->{budgets}->{correctness};
    my $resources = $manifest->{budgets}->{resources};
    my $phase1 = $manifest->{budgets}->{phase1_resources};
    my $environment = $manifest->{run_environment};
    die "benchmark resource profile is invalid\n"
      if ref($correctness) ne "HASH" || ref($resources) ne "HASH"
      || ref($phase1) ne "HASH" || ref($environment) ne "HASH";
    for my $field (
        qw(
        max_false_confirmed_claims
        max_silent_truncations
        max_mixed_generation_reads
        max_false_automatic_relinks
        )
      )
    {
        die "benchmark correctness profile is invalid\n"
          if !defined($correctness->{$field}) || ref($correctness->{$field})
          || $correctness->{$field} !~ /\A0\z/;
    }
    my $warm_query_runs = $environment->{warm_query_runs};
    my $quiet_poll_session_ms = $phase1->{quiet_poll_session_ms};
    die "benchmark warm-query profile is invalid\n"
      if !defined($warm_query_runs) || ref($warm_query_runs)
      || $warm_query_runs !~ /\A[1-9][0-9]*\z/ || $warm_query_runs > 1000
      || $warm_query_runs != $by_id{"native-graph-read-suite"}
      || !JSON::PP::is_bool($environment->{cold_and_warm_runs_required})
      || !$environment->{cold_and_warm_runs_required};
    die "benchmark quiet-poll session is invalid\n"
      if !defined($quiet_poll_session_ms) || ref($quiet_poll_session_ms)
      || $quiet_poll_session_ms !~ /\A[1-9][0-9]*\z/
      || $quiet_poll_session_ms < 100 || $quiet_poll_session_ms > 10_000;
    my @budget_values = (
      $resources->{max_full_index_wall_ms},
      $resources->{max_peak_rss_mib},
      $resources->{max_warm_query_p95_ms},
      $resources->{max_material_result_bytes},
      $resources->{max_database_bytes},
      $resources->{max_wal_bytes_after_completion},
      $phase1->{max_two_source_publication_wall_ms},
      $phase1->{max_quiet_poll_p95_ms},
      $phase1->{max_native_graph_read_p95_ms},
      $phase1->{max_retention_plan_wall_ms},
      $phase1->{max_retention_apply_wall_ms},
      $phase1->{max_retained_generations_per_source_slot_after_collection},
    );
    my @minimums = (1, 1, 1, 1, 1, 0, 1, 1, 1, 1, 1, 1);
    my @maximums = (
      3_600_000, 1_048_576, 3_600_000, 25_165_824,
      17_179_869_184, 17_179_869_184, 895_000, 3_600_000,
      3_600_000, 3_600_000, 3_600_000, 1_000,
    );
    for my $index (0 .. $#budget_values) {
        my $value = $budget_values[$index];
        die "benchmark resource profile is invalid\n"
          if !defined($value) || ref($value) || $value !~ /\A[0-9]+\z/
          || $value < $minimums[$index]
          || $value > $maximums[$index];
    }
    die "warm-query and native-graph budgets must match\n"
      if $resources->{max_warm_query_p95_ms}
      != $phase1->{max_native_graph_read_p95_ms};
    print join " ",
      $revision,
      (map { $_, $by_id{$_} } @expected),
      $warm_query_runs,
      "true",
      $quiet_poll_session_ms,
      @budget_values;
' -- "$MANIFEST"
then
    echo "error: benchmark manifest execution profile was invalid" >&2
    exit 65
fi
EXECUTION_VALUES=$(cat "$BENCHMARK_TEMP/manifest-values.output")
set -f
set -- $EXECUTION_VALUES
set +f
if [ "$#" -ne 32 ]; then
    echo "error: benchmark manifest execution profile was incomplete" >&2
    exit 65
fi

EXPECTED_REVISION=$1
ATOMIC_WORKLOAD=$2
ATOMIC_RUNS=$3
TWO_WORKTREE_WORKLOAD=$4
TWO_WORKTREE_RUNS=$5
QUIET_WORKLOAD=$6
QUIET_RUNS=$7
SELECTOR_WORKLOAD=$8
SELECTOR_RUNS=$9
shift 9
SCOPE_WORKLOAD=$1
SCOPE_RUNS=$2
GRAPH_WORKLOAD=$3
GRAPH_RUNS=$4
COMPATIBILITY_WORKLOAD=$5
COMPATIBILITY_RUNS=$6
RETENTION_WORKLOAD=$7
RETENTION_RUNS=$8
shift 8
WARM_QUERY_RUNS=$1
COLD_AND_WARM_RUNS_REQUIRED=$2
QUIET_POLL_SESSION_MS=$3
shift 3
MAX_FULL_INDEX_WALL_MS=$1
MAX_PEAK_RSS_MIB=$2
MAX_WARM_QUERY_MS=$3
MAX_MATERIAL_RESULT_BYTES=$4
MAX_DATABASE_BYTES=$5
MAX_WAL_BYTES_AFTER_COMPLETION=$6
MAX_TWO_SOURCE_PUBLICATION_MS=$7
MAX_QUIET_POLL_MS=$8
MAX_NATIVE_GRAPH_READ_MS=$9
shift 9
MAX_RETENTION_PLAN_MS=$1
MAX_RETENTION_APPLY_MS=$2
MAX_RETAINED_GENERATIONS=$3
MAX_PEAK_RSS_KIB=$((MAX_PEAK_RSS_MIB * 1024))

if ! run_bounded_benchmark_git \
    "$BENCHMARK_TEMP/corpus-revision.output" "$BENCHMARK_TEMP/corpus-preflight.log" \
    -C "$CORPUS_ROOT" rev-parse --verify HEAD
then
    echo "error: benchmark corpus could not be verified" >&2
    exit 65
fi
ACTUAL_REVISION=$(cat "$BENCHMARK_TEMP/corpus-revision.output")
if [ "$ACTUAL_REVISION" != "$EXPECTED_REVISION" ]; then
    echo "error: corpus revision does not match the Phase 1 manifest" >&2
    exit 65
fi
if ! run_bounded_benchmark_git \
    "$BENCHMARK_TEMP/corpus-status.output" "$BENCHMARK_TEMP/corpus-status.log" \
    -C "$CORPUS_ROOT" status --porcelain --untracked-files=all
then
    echo "error: benchmark corpus could not be verified" >&2
    exit 65
fi
if [ -s "$BENCHMARK_TEMP/corpus-status.output" ]; then
    echo "error: corpus worktree must be clean" >&2
    exit 65
fi

WORKTREE_ONE=$BENCHMARK_TEMP/worktree-one
WORKTREE_TWO=$BENCHMARK_TEMP/worktree-two
OPERATION_DATABASE=$BENCHMARK_TEMP/operation-index.sqlite3
ATOMIC_MANIFEST=$BENCHMARK_TEMP/atomic-workspace.toml
TWO_WORKTREE_MANIFEST=$BENCHMARK_TEMP/two-worktree-workspace.toml
CLI=target/release/repowitness
OPERATION_PROBE=target/release/examples/phase1_operation_probe

if ! create_bounded_checkout "$WORKTREE_ONE" worktree-one \
    || ! create_bounded_checkout "$WORKTREE_TWO" worktree-two
then
    echo "error: benchmark corpus setup failed" >&2
    exit 65
fi

if ! run_bounded_capture "$BENCHMARK_TEMP/build.output" "$BENCHMARK_TEMP/build.log" \
    cargo build --release --locked \
        -p repowitness-cli --bin repowitness \
        -p repowitness-local --example phase1_operation_probe
then
    echo "error: benchmark runner build failed" >&2
    exit 70
fi
if ! run_bounded_capture \
    "$BENCHMARK_TEMP/local-tests-build.output" "$BENCHMARK_TEMP/local-tests-build.log" \
    cargo test -p repowitness-local --release --locked --lib --no-run \
    || ! run_bounded_capture \
        "$BENCHMARK_TEMP/cli-tests-build.output" "$BENCHMARK_TEMP/cli-tests-build.log" \
        cargo test -p repowitness-cli --release --locked --test cli_contract --no-run \
    || ! run_bounded_capture \
        "$BENCHMARK_TEMP/mcp-tests-build.output" "$BENCHMARK_TEMP/mcp-tests-build.log" \
        cargo test -p repowitness-mcp --release --locked --lib --no-run
then
    echo "error: benchmark runner test preparation failed" >&2
    exit 70
fi

generate_identity() {
    if ! run_bounded_capture \
        "$BENCHMARK_TEMP/identity.output" "$BENCHMARK_TEMP/identity.errors" \
        "$CLI" identity generate "$1"
    then
        return 1
    fi
    required_single_line "$BENCHMARK_TEMP/identity.output" "generated identity"
}

CONNECTED_ONE=$(generate_identity connected-workspace)
CONNECTED_TWO=$(generate_identity connected-workspace)
REPOSITORY_ONE=$(generate_identity repository)
REPOSITORY_TWO=$(generate_identity repository)
REPOSITORY_THREE=$(generate_identity repository)
OPERATION_REPOSITORY=$(generate_identity repository)
SLOT_ONE=$(generate_identity source-slot)
SLOT_TWO=$(generate_identity source-slot)
SLOT_THREE=$(generate_identity source-slot)
SLOT_FOUR=$(generate_identity source-slot)

write_manifest() {
    output=$1
    workspace=$2
    first_slot=$3
    first_repository=$4
    first_root=$5
    second_slot=$6
    second_repository=$7
    second_root=$8
    printf '%s\n' \
        'schema_version = 1' \
        "connected_workspace_id = \"$workspace\"" \
        '' \
        '[[source]]' \
        "source_slot_id = \"$first_slot\"" \
        "repository_identity = \"$first_repository\"" \
        "worktree_root = \"$first_root\"" \
        '' \
        '[source.selector]' \
        'kind = "worktree-head"' \
        '' \
        '[source.scope]' \
        'kind = "whole-repository"' \
        '' \
        '[[source]]' \
        "source_slot_id = \"$second_slot\"" \
        "repository_identity = \"$second_repository\"" \
        "worktree_root = \"$second_root\"" \
        '' \
        '[source.selector]' \
        'kind = "worktree-head"' \
        '' \
        '[source.scope]' \
        'kind = "whole-repository"' >"$output"
}

write_manifest \
    "$ATOMIC_MANIFEST" "$CONNECTED_ONE" "$SLOT_ONE" "$REPOSITORY_ONE" "$WORKTREE_ONE" \
    "$SLOT_TWO" "$REPOSITORY_TWO" "$WORKTREE_TWO"
write_manifest \
    "$TWO_WORKTREE_MANIFEST" "$CONNECTED_TWO" "$SLOT_THREE" "$REPOSITORY_THREE" "$WORKTREE_ONE" \
    "$SLOT_FOUR" "$REPOSITORY_THREE" "$WORKTREE_TWO"

run_workload() {
    workload=$1
    runs=$2
    expected_tests=$3
    measurement=$4
    maximum_p95_ms=$5
    shift 5
    case "$measurement" in
        operation|test-harness)
            ;;
        *)
            echo "error: benchmark timing profile is invalid" >&2
            return 1
            ;;
    esac
    case "$maximum_p95_ms" in
        ''|*[!0-9]*)
            echo "error: benchmark timing budget is invalid" >&2
            return 1
            ;;
    esac
    command_deadline_ms=$MAX_COMMAND_WALL_MS
    if [ "$maximum_p95_ms" -gt 0 ]; then
        if [ "$maximum_p95_ms" -gt \
            $((MAX_COMMAND_WALL_MS - COMMAND_DEADLINE_GRACE_MS)) ]
        then
            echo "error: benchmark timing budget exceeds the capture bound" >&2
            return 1
        fi
        command_deadline_ms=$((maximum_p95_ms + COMMAND_DEADLINE_GRACE_MS))
    fi
    timings=$BENCHMARK_TEMP/$workload.timings
    output=$BENCHMARK_TEMP/$workload.output
    errors=$BENCHMARK_TEMP/$workload.errors
    attempt=1
    : >"$timings"
    if ! PHASE1_CAPTURE_DEADLINE_MS=$command_deadline_ms \
        run_workload_command "$output" "$errors" "$@"
    then
        echo "error: benchmark workload failed: $workload" >&2
        return 1
    fi
    if [ "$expected_tests" -gt 0 ] \
        && ! grep -Fq "test result: ok. $expected_tests passed; 0 failed;" "$output"
    then
        echo "error: benchmark workload did not execute its expected tests: $workload" >&2
        return 1
    fi
    while [ "$attempt" -le "$runs" ]; do
        if ! started=$(monotonic_now_us); then
            echo "error: benchmark monotonic clock was unavailable" >&2
            return 1
        fi
        if ! PHASE1_CAPTURE_DEADLINE_MS=$command_deadline_ms \
            run_workload_command "$output" "$errors" "$@"
        then
            echo "error: benchmark workload failed: $workload" >&2
            return 1
        fi
        if [ "$expected_tests" -gt 0 ] \
            && ! grep -Fq "test result: ok. $expected_tests passed; 0 failed;" "$output"
        then
            echo "error: benchmark workload did not execute its expected tests: $workload" >&2
            return 1
        fi
        if ! finished=$(monotonic_now_us); then
            echo "error: benchmark monotonic clock was unavailable" >&2
            return 1
        fi
        elapsed_us=$((finished - started))
        if [ "$elapsed_us" -lt 0 ]; then
            echo "error: benchmark clock moved backwards" >&2
            return 1
        fi
        elapsed_ms=$(((elapsed_us + 999) / 1000))
        printf '%s\n' "$elapsed_ms" >>"$timings"
        attempt=$((attempt + 1))
    done
    rank=$(((runs * 95 + 99) / 100))
    p95=$(sort -n "$timings" | sed -n "${rank}p")
    case "$p95" in
        ''|*[!0-9]*)
            echo "error: benchmark timing collection failed" >&2
            return 1
            ;;
    esac
    if [ "$maximum_p95_ms" -gt 0 ] && [ "$p95" -gt "$maximum_p95_ms" ]; then
        echo "error: benchmark workload exceeded its wall-time budget: $workload" >&2
        return 1
    fi
    printf 'workload=%s runs=%s measurement=%s wall_p95_ms=%s status=passed\n' \
        "$workload" "$runs" "$measurement" "$p95"
}

# Shell functions are intentionally internal, fixed workload adapters. They
# emit no output themselves and capture their small structured CLI reports in
# dedicated files. External commands always use the bounded stream capture.
run_workload_command() (
    output=$1
    errors=$2
    shift 2
    case "$1" in
        run_atomic_workspace|run_two_worktree_workspace|run_compatibility_suite|run_retention_suite)
            "$@" >"$output" 2>"$errors"
            ;;
        *)
            run_bounded_capture "$output" "$errors" "$@"
            ;;
    esac
)

verify_workspace_report() {
    report=$1
    database=$2
    first_root=$3
    second_root=$4
    first_repository=$5
    second_repository=$6
    if ! perl scripts/check-phase1-workspace-receipt \
        "$report" "$database" \
        "$MAX_DATABASE_BYTES" "$MAX_WAL_BYTES_AFTER_COMPLETION" >/dev/null
    then
        return 1
    fi
    for sensitive in \
        "$BENCHMARK_TEMP" "$first_root" "$second_root" \
        "$first_repository" "$second_repository"
    do
        if grep -Fq "$sensitive" "$report"; then
            return 1
        fi
    done
}

run_atomic_workspace() {
    report=$BENCHMARK_TEMP/atomic-workspace.report
    database=$(fresh_workload_database atomic-workspace) || return 1
    if ! run_bounded_capture "$report" "$BENCHMARK_TEMP/atomic-workspace.errors" \
        "$CLI" workspace index --manifest "$ATOMIC_MANIFEST" --database "$database"
    then
        return 1
    fi
    if ! verify_workspace_report \
        "$report" "$database" \
        "$WORKTREE_ONE" "$WORKTREE_TWO" "$REPOSITORY_ONE" "$REPOSITORY_TWO"
    then
        return 1
    fi
    remove_fresh_workload_database "$database"
}

run_two_worktree_workspace() {
    report=$BENCHMARK_TEMP/two-worktree-workspace.report
    database=$(fresh_workload_database two-worktree-workspace) || return 1
    if ! run_bounded_capture "$report" "$BENCHMARK_TEMP/two-worktree-workspace.errors" \
        "$CLI" workspace index --manifest "$TWO_WORKTREE_MANIFEST" --database "$database"
    then
        return 1
    fi
    if ! verify_workspace_report \
        "$report" "$database" \
        "$WORKTREE_ONE" "$WORKTREE_TWO" "$REPOSITORY_THREE" "$REPOSITORY_THREE"
    then
        return 1
    fi
    remove_fresh_workload_database "$database"
}

run_operation_probe() {
    output=$BENCHMARK_TEMP/operation-probe.output
    errors=$BENCHMARK_TEMP/operation-probe.errors
    time_output=$BENCHMARK_TEMP/operation-probe.time
    case "$(uname -s)" in
        Linux)
            if [ ! -x /usr/bin/time ] \
                || ! run_bounded_capture "$output" "$errors" \
                    /usr/bin/time -f 'peak_rss_kib=%M' -o "$time_output" \
                    "$OPERATION_PROBE" \
                    "$WORKTREE_ONE" "$OPERATION_DATABASE" "$OPERATION_REPOSITORY" \
                    "$QUIET_RUNS" "$GRAPH_RUNS" "$RETENTION_RUNS" \
                    "$WARM_QUERY_RUNS" "$COLD_AND_WARM_RUNS_REQUIRED" \
                    "$QUIET_POLL_SESSION_MS" \
                    "$MAX_FULL_INDEX_WALL_MS" \
                    "$MAX_QUIET_POLL_MS" "$MAX_WARM_QUERY_MS" \
                    "$MAX_NATIVE_GRAPH_READ_MS" \
                    "$MAX_RETENTION_PLAN_MS" "$MAX_RETENTION_APPLY_MS" \
                    "$MAX_RETAINED_GENERATIONS" "$MAX_MATERIAL_RESULT_BYTES" \
                    "$MAX_DATABASE_BYTES" "$MAX_WAL_BYTES_AFTER_COMPLETION"
            then
                echo "error: Phase 1 operation probe failed" >&2
                return 1
            fi
            peak_rss_kib=$(sed -n 's/^peak_rss_kib=//p' "$time_output")
            ;;
        Darwin)
            if [ ! -x /usr/bin/time ] \
                || ! run_bounded_capture "$output" "$errors" \
                    /usr/bin/time -l "$OPERATION_PROBE" \
                    "$WORKTREE_ONE" "$OPERATION_DATABASE" "$OPERATION_REPOSITORY" \
                    "$QUIET_RUNS" "$GRAPH_RUNS" "$RETENTION_RUNS" \
                    "$WARM_QUERY_RUNS" "$COLD_AND_WARM_RUNS_REQUIRED" \
                    "$QUIET_POLL_SESSION_MS" \
                    "$MAX_FULL_INDEX_WALL_MS" \
                    "$MAX_QUIET_POLL_MS" "$MAX_WARM_QUERY_MS" \
                    "$MAX_NATIVE_GRAPH_READ_MS" \
                    "$MAX_RETENTION_PLAN_MS" "$MAX_RETENTION_APPLY_MS" \
                    "$MAX_RETAINED_GENERATIONS" "$MAX_MATERIAL_RESULT_BYTES" \
                    "$MAX_DATABASE_BYTES" "$MAX_WAL_BYTES_AFTER_COMPLETION"
            then
                echo "error: Phase 1 operation probe failed" >&2
                return 1
            fi
            peak_rss_kib=$(awk '
                /maximum resident set size/ {
                    printf "%d\n", $1 / 1024
                    found = 1
                    exit
                }
                END { if (!found) exit 1 }
            ' "$errors") || return 1
            ;;
        *)
            echo "error: operation probe RSS measurement is unsupported" >&2
            return 1
            ;;
    esac
    case "$peak_rss_kib" in
        ''|*[!0-9]*|0)
            echo "error: operation probe peak RSS receipt was invalid" >&2
            return 1
            ;;
    esac
    if [ "$peak_rss_kib" -gt "$MAX_PEAK_RSS_KIB" ]; then
        echo "error: operation probe exceeded the peak RSS budget" >&2
        return 1
    fi
    if ! grep -qx 'benchmark_id=phase1-trustworthy-local-core-v1' "$output" \
        || ! grep -qx "budget_max_full_index_wall_ms=$MAX_FULL_INDEX_WALL_MS" "$output" \
        || ! grep -qx "budget_max_warm_query_p95_ms=$MAX_WARM_QUERY_MS" "$output" \
        || ! grep -qx \
            "native_graph_material_result_bound_bytes=$MAX_MATERIAL_RESULT_BYTES" \
            "$output" \
        || ! grep -qx \
            "budget_max_material_result_bytes=$MAX_MATERIAL_RESULT_BYTES" \
            "$output" \
        || ! grep -qx "budget_max_database_bytes=$MAX_DATABASE_BYTES" "$output" \
        || ! grep -qx \
            "budget_max_wal_bytes_after_completion=$MAX_WAL_BYTES_AFTER_COMPLETION" \
            "$output" \
        || ! grep -qx "database_bytes=[0-9][0-9]*" "$output" \
        || ! grep -qx "wal_bytes=$MAX_WAL_BYTES_AFTER_COMPLETION" "$output"
    then
        echo "error: operation probe resource receipt validation failed" >&2
        return 1
    fi
    if ! grep -qx 'probe_kind=operation-level' "$output" \
        || ! grep -qx "warm_query_runs=$WARM_QUERY_RUNS" "$output" \
        || ! grep -qx 'warm_query_p95_us=[0-9][0-9]*' "$output" \
        || ! grep -qx \
            "cold_and_warm_runs_required=$COLD_AND_WARM_RUNS_REQUIRED" "$output" \
        || ! grep -qx "quiet_poll_session_ms=$QUIET_POLL_SESSION_MS" "$output" \
        || ! grep -qx "quiet_poll_runs=$QUIET_RUNS" "$output" \
        || ! grep -qx "native_graph_read_runs=$GRAPH_RUNS" "$output" \
        || ! grep -qx "retention_runs=$RETENTION_RUNS" "$output" \
        || ! grep -qx 'quiet_poll_publications=0' "$output" \
        || ! grep -qx 'unchanged_generation_delta=0' "$output" \
        || ! grep -qx 'mixed_generation_reads=0' "$output" \
        || ! grep -qx 'retention_final_candidates=0' "$output" \
        || ! grep -qx 'correctness_failures=0' "$output"
    then
        echo "error: operation probe correctness receipt validation failed" >&2
        return 1
    fi
    for sensitive in \
        "$BENCHMARK_TEMP" "$WORKTREE_ONE" "$WORKTREE_TWO" \
        "$OPERATION_DATABASE" "$OPERATION_REPOSITORY"
    do
        if grep -Fq "$sensitive" "$output"; then
            echo "error: operation probe output exposed a private input" >&2
            return 1
        fi
    done
    echo "peak_rss_kib=$peak_rss_kib"
    cat "$output"
}

if ! emit_run_environment; then
    echo "error: benchmark environment receipt was incomplete" >&2
    exit 65
fi
if ! run_operation_probe_contract_suite; then
    echo "error: Phase 1 operation-probe contract tests failed" >&2
    exit 1
fi
if ! run_trustworthiness_suite; then
    echo "error: Phase 1 trustworthiness regressions failed" >&2
    exit 1
fi
if ! run_operation_probe; then
    exit 1
fi
if ! run_workload \
    "$ATOMIC_WORKLOAD" "$ATOMIC_RUNS" 0 operation \
    "$MAX_TWO_SOURCE_PUBLICATION_MS" run_atomic_workspace
then
    exit 1
fi
if ! run_workload \
    "$TWO_WORKTREE_WORKLOAD" "$TWO_WORKTREE_RUNS" 0 operation \
    "$MAX_TWO_SOURCE_PUBLICATION_MS" run_two_worktree_workspace
then
    exit 1
fi
if ! run_workload "$QUIET_WORKLOAD" "$QUIET_RUNS" 1 test-harness 0 \
    cargo test -p repowitness-local --release --locked --lib \
    local_index::tests::watched_reconciliation_skips_unchanged_source_and_publishes_changes \
    -- --exact --test-threads=1
then
    exit 1
fi
if ! run_workload "$SELECTOR_WORKLOAD" "$SELECTOR_RUNS" 1 test-harness 0 \
    cargo test -p repowitness-local --release --locked --lib \
    local_index::connected_workspace::tests::faults::moving_ref_after_preparation_fails_the_final_fence_and_preserves_view \
    -- --exact --test-threads=1
then
    exit 1
fi
if ! run_workload "$SCOPE_WORKLOAD" "$SCOPE_RUNS" 3 test-harness 0 \
    cargo test -p repowitness-local --release --locked --lib \
    local_index::connected_workspace::tests::scopes:: -- --test-threads=1
then
    exit 1
fi
if ! run_workload "$GRAPH_WORKLOAD" "$GRAPH_RUNS" 1 test-harness 0 \
    cargo test -p repowitness-cli --release --locked --test cli_contract \
    mcp_stdio_indexes_searches_retrieves_and_rejects_a_stale_selector -- --exact --test-threads=1
then
    exit 1
fi
if ! run_workload \
    "$COMPATIBILITY_WORKLOAD" "$COMPATIBILITY_RUNS" 0 test-harness 0 \
    run_compatibility_suite
then
    exit 1
fi
if ! run_workload \
    "$RETENTION_WORKLOAD" "$RETENTION_RUNS" 0 test-harness 0 \
    run_retention_suite
then
    exit 1
fi
if ! verify_final_git_state; then
    exit 1
fi

printf 'status=passed phase=phase1 workloads=8\n'
